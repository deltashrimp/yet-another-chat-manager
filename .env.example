# Telegram bot token, from @BotFather
# Loaded from process environment first, then from this .env file
# (./.env by default, any KEY=VALUE file via --config-updates later).
BOT_TOKEN=

# Telegram ID of the bot developer (has global bot_owner role)
BOT_OWNER_ID=0

# SQLite database file (parent directory is created automatically)
# Local default: ./data/bot.db — in Docker override with /data/bot.db
# (volume-mounted to /data).
DB_PATH=./data/bot.db

# Default bot language in chats (supported: en, ru)
DEFAULT_LANG=en

# Log level: trace, debug, info, warn, error, critical
LOG_LEVEL=info

# Long-polling timeout in seconds
POLL_TIMEOUT=30

# Directory with translation files (i18n/<lang>.json)
I18N_DIR=./i18n

# Path to welcome message file used by /start
WELCOME_MESSAGE=./resources/welcome-message-public.md

# --- AI assistant (optional) -------------------------------------------
# Any OpenAI-compatible chat-completions endpoint (Groq, OpenRouter,
# OpenAI, local llama.cpp/Ollama). AI is disabled while AI_API_KEY is empty.
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Added to the system prompt: literal text, or a file path such as
# ./resources/personality/ruleset.md (relative to the bot's working
# directory, /app in Docker). "file:/path" also works. Files are re-read
# by the bot owner's /aireload.
AI_RULES=
AI_BIO=

# Request parameters. Sampling values are only sent when set.
AI_MAX_TOKENS=1000
#AI_TEMPERATURE=1.0
#AI_TOP_P=1.0
#AI_FREQUENCY_PENALTY=0
#AI_PRESENCE_PENALTY=0
AI_TIMEOUT=60

# Abuse limits: seconds between requests of one user, requests per chat
# per minute, and pending requests before the bot answers "busy".
AI_USER_COOLDOWN=10
AI_CHAT_PER_MIN=10
AI_QUEUE_LIMIT=50
